# copy to .env or export in the shell; every variable is optional

# where the gateway proxies /api/* to
GATEWAY_UPSTREAM_URL=http://127.0.0.1:9000

# redis for shared limiter state; unset/unreachable = in-memory fallback
GATEWAY_REDIS_URL=redis://127.0.0.1:6379/0

# api keys: "key-id=secret" pairs (hashed in memory at startup)
GATEWAY_API_KEYS=demo=demo-key
# ...or a JSON file of pre-hashed keys: {"key-id": "<sha256 of secret>"}
# GATEWAY_API_KEYS_FILE=keys.json

# rate limiting
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_STRATEGY=token_bucket
GATEWAY_RATE_LIMIT_REQUESTS=100
GATEWAY_RATE_LIMIT_WINDOW=60
GATEWAY_ROUTE_LIMITS={"/api/search": {"requests": 10, "window": 60}}
